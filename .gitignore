.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Data and runs never go into git. Audio may carry consent restrictions.
data/raw/
data/fleurs/
data/own/
# Held-out transcripts are private speech too; only the folder's README is kept.
data/heldout/*
!data/heldout/README.md
workspace/
exports/
runs/**/predictions.jsonl
runs/**/*.log
# Pipeline smoke tests use stand-in models; their numbers are not Gyara results.
runs/smoke-*/
checkpoints/
*.wav
*.mp3
*.m4a
*.mp4
*.flac
*.ogg
*.opus
*.webm
*.aac
*.mov
*.db
*.sqlite3
.env
hf_token*

# Keep small, committed benchmark summaries.
!runs/**/metrics.json
!runs/**/report.md
# Predictions on public FLEURS data (CC-BY-4.0) are kept so anyone can re-score.
# Own-audio runs must not be named or placed like these.
!runs/*fleurs*/predictions.jsonl
!runs/dev/*/predictions.jsonl
!runs/probe/*/predictions.jsonl

.claude/worktrees/
.claude/settings.local.json
